{
  "name": "toyota-showroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "predev": "tsx scripts/generate-static-api.ts",
    "prebuild": "tsx scripts/generate-static-api.ts",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply toyota-showroom --local",
    "db:migrate:remote": "wrangler d1 migrations apply toyota-showroom --remote",
    "db:migrate:staging": "wrangler d1 migrations apply toyota-showroom-staging --remote --env staging --config wrangler.jsonc",
    "db:studio": "drizzle-kit studio",
    "deploy": "npm run build && wrangler deploy dist/server/index.js --no-bundle --env \"\" --config wrangler.jsonc",
    "deploy:staging": "npm run build && wrangler deploy dist/server/index.js --no-bundle --env staging --config wrangler.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^27.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^3.2.7",
    "wrangler": "4.92.0"
  }
}
