# Only needed for drizzle-kit commands that talk to the real D1 instance over Cloudflare's HTTP
# API (`npm run db:studio`; `wrangler d1 migrations apply --remote` uses wrangler's own Cloudflare
# auth instead, not these). `npm run db:generate` needs none of this — it only diffs db/schema.ts
# against db/migrations locally.
#
# CLOUDFLARE_ACCOUNT_ID    — Cloudflare dashboard → Workers & Pages → Overview (right sidebar).
# CLOUDFLARE_DATABASE_ID   — the `database_id` wrangler.jsonc's d1_databases entry uses; same value
#                            `wrangler d1 create toyota-showroom` prints.
# CLOUDFLARE_D1_TOKEN      — a Cloudflare API token scoped to "D1: Edit" for the account above
#                            (dashboard → My Profile → API Tokens → Create Token).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
